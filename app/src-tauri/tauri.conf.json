{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Opti MQTT Tester",
  "version": "2.0.0",
  "identifier": "dk.optipeople.mqtt-tester",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Opti MQTT Tester",
        "width": 1280,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "OptiPeople",
    "copyright": "OptiPeople ApS",
    "category": "DeveloperTool",
    "shortDescription": "Test and configure PLC MQTT connections to the OptiPeople IoT Hub",
    "resources": ["resources/AzureIoTHub-CA.pem"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
